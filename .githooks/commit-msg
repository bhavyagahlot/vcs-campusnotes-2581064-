#!/bin/sh
msg=$(cat "$1")

if [ ${#msg} -lt 10 ]; then
    echo "ERROR: Commit message must be at least 10 characters."
    exit 1
fi

case "$msg" in
    feat:*|fix:*|docs:*|refactor:*|chore:*) exit 0 ;;
    *)
        echo "ERROR: Commit message must start with feat:, fix:, docs:, refactor:, or chore:."
        exit 1
        ;;
esac
